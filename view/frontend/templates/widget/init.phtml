<?php
/** @var \Comfino\ComfinoGateway\Block\Widget\Init $block */
/** @var \Magento\Framework\Escaper $escaper */

/* Product-page widget via the CDN product widget script (WIDGET_BRIDGE_MIGRATION_PLAN §3): emit the JSON config
   block and the deferred per-platform script that reads it, imports the SDK, and calls sdk.bootstrapWidget().
   Replaces the legacy inline init served from the comfino/script/index controller. */
$configJson = $block->getWidgetConfigJson();
if (!$configJson) {
    return;
}
?>
<script type="application/json" id="<?= $escaper->escapeHtmlAttr($block->getWidgetConfigElementId()) ?>"><?= /* @noEscape */ $configJson ?></script>
<script defer src="<?= $escaper->escapeUrl($block->getProductWidgetScriptUrl()) ?>"></script>